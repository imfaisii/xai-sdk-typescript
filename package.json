{
  "name": "xai-sdk-js",
  "version": "0.3.0",
  "description": "TypeScript/JavaScript SDK for the xAI API (gRPC)",
  "license": "Apache-2.0",
  "author": "imfaisii",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "worker": "./dist/index-web.js",
      "browser": "./dist/index-web.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web": {
      "types": "./dist/index-web.d.ts",
      "import": "./dist/index-web.js",
      "require": "./dist/index-web.cjs"
    },
    "./proto/*": "./dist/gen/*"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "gen": "buf generate",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "release": "bash ./scripts/release.sh",
    "prepublishOnly": "bun run gen && bun run build && bun run typecheck && bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imfaisii/xai-sdk-typescript.git"
  },
  "homepage": "https://github.com/imfaisii/xai-sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/imfaisii/xai-sdk-typescript/issues"
  },
  "keywords": [
    "xai",
    "grok",
    "sdk",
    "typescript",
    "grpc",
    "llm"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-node": "^2.0.0",
    "@connectrpc/connect-web": "^2.1.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.47.0",
    "@bufbuild/protoc-gen-es": "^2.2.0",
    "@types/bun": "^1.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
